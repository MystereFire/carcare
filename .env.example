# Une seule configuration pour toute l’application.
PORT=5000
# Interface HTTP : 127.0.0.1 en développement, 0.0.0.0 en production.
# Garder 0.0.0.0 dans Docker.
# HOST=0.0.0.0
# Nombre de proxies de confiance devant Express : 0 (défaut) à 5.
# Derrière un seul reverse proxy HTTPS : TRUST_PROXY=1.
# TRUST_PROXY=0

# Requis avec npm start (production). Utiliser une clé aléatoire longue.
# Facultatif avec npm run dev : une clé temporaire est créée au démarrage.
JWT_SECRET=

# Facultatif : sans cette variable, stockage local dans data/carcare.sqlite.
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/carcare
# SQLITE_PATH=data/carcare.sqlite
# Valeur spéciale : :memory: pour des tests sans fichier persistant.
# Dans Docker, utiliser un chemin sous /app/data pour conserver les données.

# Connexion Google facultative : renseigner les deux identifiants ensemble.
# Origines publiques uniquement (pas de chemin), même serveur pour les deux URL.
# Si PORT change, les URL locales sont déduites de ce port automatiquement.
# API_URL=http://localhost:5000
# FRONTEND_URL=http://localhost:5000
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# VITE_GOOGLE_AUTH_ENABLED=true

# Alertes par e-mail facultatives : SMTP_USER nécessite SMTP_HOST et SMTP_PASS.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
